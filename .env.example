# Render / PostgreSQL
# External Database URL (recomendado en Render, desde el dashboard → Connect):
# DATABASE_URL=postgresql://user:pass@dpg-xxxx.region-postgres.render.com:5432/dbname

DB_NAME=subastas_bd
DB_USER=subastas_bd_user
DB_PASSWORD=
# Host EXTERNO (ej.: dpg-xxxx.region-postgres.render.com), no el internal-only
DB_HOST=
DB_PORT=5432
DB_SSL_REQUIRE=true
