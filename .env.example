# Render / PostgreSQL
# External Database URL (recomendado en Render, desde el dashboard → Connect):
# DATABASE_URL=postgresql://user:pass@dpg-xxxx.region-postgres.render.com:5432/dbname

DB_NAME=subastas_bd
DB_USER=subastas_bd_user
DB_PASSWORD=
# Host EXTERNO (ej.: dpg-xxxx.region-postgres.render.com), no el internal-only
DB_HOST=
DB_PORT=5432
DB_SSL_REQUIRE=true

# Front (CORS + CSRF). Optional: extra origins, comma-separated, no trailing slash.
# On Render the API already allows https://front-bidnow.onrender.com and Vite local URLs.
FRONTEND_ORIGINS=
# Solo si el front envia cookies/credenciales: CORS_ALLOW_CREDENTIALS=true
