# Render / PostgreSQL
# PRIORIDAD: si defines DATABASE_URL, Django IGNORA DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT.
#
# IMPORTANTE (Render): el host "interno" tipo dpg-xxxxx-a (sin dominio) SOLO resuelve DNS dentro de Render
# si el Web Service y el Postgres estan ENLAZADOS (Add database / mismo proyecto). Si ves:
#   could not translate host name "dpg-..." to address: Name or service not known
# entonces: (1) En el servicio web -> Environment -> enlaza la BD de Render, O
#           (2) Usa la "External Database URL" (host ...REGION-postgres.render.com) en DATABASE_URL.
#
# Si solo tienes el host corto (dpg-xxxxx-a), puedes añadir el sufijo de region (sin comillas extra):
# DATABASE_HOST_SUFFIX=.oregon-postgres.render.com
# (cambia la region segun tu BD en el dashboard de Render)
#
# Para desarrollo local o cuando pegas la URL a mano, usa casi siempre la URL EXTERNA.
# No pegues contraseñas reales en commits.
# Ejemplo de forma (reemplaza USER, PASSWORD, host y db):
# DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxx.REGION-postgres.render.com:5432/DATABASE?sslmode=require
DATABASE_URL=

# Fallback SOLO si NO usas DATABASE_URL:
DB_NAME=
DB_USER=
DB_PASSWORD=
# Host EXTERNO (ej.: dpg-xxxx.region-postgres.render.com). Para desarrollo local suele ser la URL externa.
DB_HOST=
DB_PORT=5432
DB_SSL_REQUIRE=true

# Front (CORS + CSRF). Optional: extra origins, comma-separated, no trailing slash.
# On Render the API already allows https://front-bidnow.onrender.com and Vite local URLs.
FRONTEND_ORIGINS=
# Solo si el front envia cookies/credenciales: CORS_ALLOW_CREDENTIALS=true

# Nivel de logs Django en consola (Render). Ej.: INFO, WARNING, ERROR
# DJANGO_LOG_LEVEL=INFO
